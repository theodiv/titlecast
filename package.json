{
  "name": "titlecast",
  "version": "0.0.0",
  "private": true,
  "description": "Pull request labeler for Conventional Commits types and scopes",
  "keywords": [
    "github-action",
    "conventional-commits",
    "labeler",
    "labels",
    "pull-request"
  ],
  "homepage": "https://github.com/theodiv/titlecast#readme",
  "bugs": {
    "url": "https://github.com/theodiv/titlecast/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theodiv/titlecast.git"
  },
  "license": "MIT",
  "author": "Theodosios Divolis",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.13.0",
    "eslint-plugin-jsdoc": "65.4.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
